{
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"lint": "eslint",
		"lint:all": "npm run lint:package && npm run lint && npm audit && npm run ci:lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"prepare": "husky; npm run lint:package",
		"update:artifacts": "artifact update",
		"update:ci": "pinact run -min-age 7 -update",
		"update:deps": "taze --all"
	},
	"dependencies": {},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@zokugun/eslint-config": "0.1.0",
		"@zokugun/eslint-config-data": "0.1.0",
		"@zokugun/eslint-config-js": "0.1.0",
		"@zokugun/eslint-config-md": "0.2.0",
		"@zokugun/eslint-config-nodejs": "0.1.0",
		"eslint": "10.8.1",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"taze": "19.16.0"
	},
	"keywords": []
}
